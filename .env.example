# Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat/user IDs (the numeric ID, not @username) that
# are administrators. Admin chats are auto-approved on first /start and get
# an Approve/Reject prompt for every other chat that tries to use the bot.
# Get your own numeric ID by messaging @userinfobot on Telegram.
ADMIN_CHAT_IDS=

# PostgreSQL
DATABASE_URL=postgres://tracker:tracker@localhost:5432/migration_tracker

# Redis
REDIS_URL=redis://localhost:6379

# Comma-separated RPC URLs per network. First entry is primary, the rest are
# failover endpoints used when the primary errors out or times out.
# Fill these in with your own Alchemy / QuickNode / Ankr / Blockpi endpoints.
# A wss:// URL gets a push WebSocket subscription (near-instant new-block
# notifications); an http(s):// URL falls back to polling. Mixing both works
# — put the wss:// endpoint first so it's tried as primary.
RPC_ETHEREUM=
RPC_BSC=
RPC_ARBITRUM=
RPC_BASE=
RPC_OPTIMISM=
RPC_POLYGON=
RPC_AVALANCHE=
RPC_LINEA=
RPC_SCROLL=
RPC_BLAST=
RPC_POLYGON_ZKEVM=
RPC_HYPEREVM=

# Optional: enables "Contract Creator" (deployer) lookups via Etherscan's
# unified multichain API (v2) — one key covers every network above, no need
# for a separate BscScan/Arbiscan/etc key per chain. Get one at
# https://etherscan.io/apis (free tier is enough for this).
ETHERSCAN_API_KEY=

# Public 4-byte signature database used to name functions of freshly deployed
# (unverified) contracts, e.g. migrateFromLEND / mkrToSky. "off" disables it.
SIGNATURE_DB_URL=https://api.4byte.sourcify.dev/signature-database/v1/lookup

# Built-in networks the scanner should watch, comma separated. Leave unset to
# watch all built-in networks. Custom networks (below) are always watched.
ENABLED_NETWORKS=ethereum,bsc,arbitrum,base,optimism,polygon,avalanche,linea,scroll,blast,polygon-zkevm,hyperevm

# Any other EVM network, no code change needed. Per key: CHAIN_ID and RPC are
# required; NAME, EXPLORER, DEXSCREENER are optional. Key "zk-sync" maps to
# NETWORK_ZK_SYNC_* / RPC_ZK_SYNC. Example:
# EXTRA_NETWORKS=sonic
# NETWORK_SONIC_CHAIN_ID=146
# RPC_SONIC=wss://...,https://...
# NETWORK_SONIC_NAME=Sonic
# NETWORK_SONIC_EXPLORER=https://sonicscan.org
# NETWORK_SONIC_DEXSCREENER=sonic
EXTRA_NETWORKS=

# Block poll interval in ms, used for networks without a working websocket RPC.
BLOCK_POLL_INTERVAL_MS=3000

# Detect contracts deployed via a factory (owner calls a contract, which
# internally CREATE/CREATE2s the new contract) using debug_traceTransaction.
# Requires an RPC endpoint that exposes the debug namespace; networks whose
# endpoint doesn't are paused for 6h at a time instead of erroring per-tx.
ENABLE_FACTORY_TRACE_DETECTION=true

# After a restart/redeploy, replay at most this many missed blocks per network.
MAX_CATCHUP_BLOCKS=2000

# Re-analyze a contract detected without Token B after each of these delays
# (seconds); an update card is sent once Token B appears.
RECHECK_DELAYS_SEC=120,600,3600,21600

# Re-discover every tracked token's owners this often (hours); 0 disables.
OWNER_REFRESH_INTERVAL_HOURS=24

LOG_LEVEL=info
