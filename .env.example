# Telegram
TELEGRAM_BOT_TOKEN=

# PostgreSQL
DATABASE_URL=postgres://tracker:tracker@localhost:5432/migration_tracker

# Redis
REDIS_URL=redis://localhost:6379

# Comma-separated RPC URLs per network. First entry is primary, the rest are
# failover endpoints used when the primary errors out or times out.
# Fill these in with your own Alchemy / QuickNode / Ankr endpoints.
RPC_ETHEREUM=
RPC_BSC=
RPC_ARBITRUM=
RPC_BASE=
RPC_OPTIMISM=
RPC_POLYGON=
RPC_AVALANCHE=
RPC_LINEA=
RPC_SCROLL=
RPC_BLAST=
RPC_POLYGON_ZKEVM=

# Optional block explorer API keys, used for contract-creator lookups as a
# fallback when RPC trace methods are unavailable.
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=

# Networks the scanner should watch on startup, comma separated (network keys
# from src/config/networks.ts). Defaults to all supported networks.
ENABLED_NETWORKS=ethereum,bsc,arbitrum,base,optimism,polygon,avalanche,linea,scroll,blast,polygon-zkevm

# Block poll interval in ms, used for networks without a working websocket RPC.
BLOCK_POLL_INTERVAL_MS=3000

LOG_LEVEL=info
